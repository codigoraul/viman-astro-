---
interface Slide {
  image: string;
  title: string;
  description: string;
  link?: string;
  buttonText?: string;
  secondaryLink?: string;
  secondaryButtonText?: string;
  /** 'orange' (marca, por defecto) | 'ghost' (contorno blanco) */
  secondaryButtonColor?: string;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
---

<div class="hero-slider-container">
  <div class="swiper hero-swiper">
    <div class="swiper-wrapper">
      {slides.map((slide, index) => (
        <div class="swiper-slide">
          <div class="slide-content">
            <div class="slide-image-wrapper">
              <img
                src={slide.image}
                alt={slide.title.replace(/\n/g, ' ')}
                class="slide-image"
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "auto"}
              />
            </div>
            <div class="slide-overlay"></div>
            <div class="slide-text">
              <h2 class="slide-title" set:html={slide.title.replace(/\n/g, '<br />')} />
              <p class="slide-description">{slide.description}</p>
              <div class="slide-buttons">
                {slide.link && slide.buttonText && (
                  <a href={slide.link} class="slide-btn slide-btn-white">
                    {slide.buttonText}
                  </a>
                )}
                {slide.secondaryLink && slide.secondaryButtonText && (
                  <a
                    href={slide.secondaryLink}
                    class={`slide-btn ${slide.secondaryButtonColor === 'ghost' ? 'slide-btn-ghost' : 'slide-btn-orange'}`}
                  >
                    {slide.secondaryButtonText}
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Paginación vertical derecha estilo viman.cl -->
    <div class="swiper-pagination"></div>
  </div>
</div>

<style>
  /* Altura fluida: nunca desborda en laptops de 720p
     y usa svh para no saltar con la barra del móvil. */
  .hero-slider-container {
    width: 100%;
    height: 700px;
    height: clamp(560px, 86svh, 760px);
    position: relative;
    overflow: hidden;
    background: #030a45;
  }

  @media (max-width: 768px) {
    .hero-slider-container {
      height: 600px;
      height: clamp(500px, 80svh, 640px);
    }
  }

  .hero-swiper {
    width: 100%;
    height: 100%;
  }

  .swiper-slide {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .slide-content {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* Wrapper para contener el efecto Ken Burns zoom */
  .slide-image-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: absolute;
    top: 0;
    left: 0;
  }

  .slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1);
  }

  /* Ken Burns sincronizado con el autoplay:
     5000ms de delay + 800ms de transición = 5.8s. */
  :global(.swiper-slide-active) .slide-image {
    animation: kenBurnsZoom 5.8s linear forwards;
  }

  @keyframes kenBurnsZoom {
    0% {
      transform: scale(1);
    }
    100% {
      transform: scale(1.08);
    }
  }

  /* Velo azul marca: oscurece arriba y abajo para que
     el texto blanco se lea sobre cualquier foto. */
  .slide-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(
        180deg,
        rgba(3, 10, 69, 0.62) 0%,
        rgba(3, 10, 69, 0.34) 45%,
        rgba(3, 10, 69, 0.68) 100%
      );
  }

  /* Texto centrado */
  .slide-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
    color: white;
    text-align: center;
    width: 90%;
    max-width: 900px;
  }

  .slide-title {
    font-size: clamp(2.1rem, 5.2vw, 3.7rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #fff;
    margin: 0 0 1.4rem;
    text-shadow: 0 2px 24px rgba(3, 10, 69, 0.45);
    opacity: 0;
  }

  :global(.swiper-slide-active) .slide-title {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .slide-description {
    font-size: clamp(1rem, 1.35vw, 1.185rem);
    line-height: 1.7;
    margin: 0 auto 2.5rem;
    max-width: 700px;
    opacity: 0;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 14px rgba(3, 10, 69, 0.4);
  }

  :global(.swiper-slide-active) .slide-description {
    animation: fadeInUp 0.8s ease-out 0.2s forwards;
  }

  /* Botones */
  .slide-buttons {
    display: flex;
    gap: 1.2rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    opacity: 0;
  }

  :global(.swiper-slide-active) .slide-buttons {
    animation: fadeInUp 0.8s ease-out 0.4s forwards;
  }

  .slide-btn {
    display: inline-block;
    padding: 1rem 2.6rem;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 50px;
    text-decoration: none;
    transition: background-color 0.3s ease, color 0.3s ease,
      border-color 0.3s ease, transform 0.25s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }

  .slide-btn:hover {
    transform: translateY(-2px);
  }

  /* Botón blanco (VER PRODUCTOS) */
  .slide-btn-white {
    background-color: #fff;
    color: var(--viman-primary, #050f68);
    border: 2px solid #fff;
    box-shadow: 0 6px 24px rgba(3, 10, 69, 0.25);
  }

  .slide-btn-white:hover {
    background-color: transparent;
    color: #fff;
  }

  /* Botón naranja de marca (CONTÁCTANOS) */
  .slide-btn-orange {
    background-color: var(--viman-secondary, #fb9500);
    color: #fff;
    border: 2px solid var(--viman-secondary, #fb9500);
    box-shadow: 0 6px 24px rgba(251, 149, 0, 0.32);
  }

  .slide-btn-orange:hover {
    background-color: var(--viman-secondary-dark, #c97700);
    border-color: var(--viman-secondary-dark, #c97700);
  }

  /* Variante contorno: alternativa al antiguo botón azul,
     que no pertenecía a la paleta de marca. */
  .slide-btn-ghost {
    background-color: transparent;
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.75);
  }

  .slide-btn-ghost:hover {
    background-color: #fff;
    color: var(--viman-primary, #050f68);
    border-color: #fff;
  }

  @media (max-width: 768px) {
    .slide-description {
      margin-bottom: 2rem;
    }

    .slide-btn {
      padding: 0.85rem 2.1rem;
      font-size: 0.8rem;
    }

    .slide-buttons {
      flex-direction: column;
      gap: 0.8rem;
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Sin animación: el texto simplemente está visible */
  @media (prefers-reduced-motion: reduce) {
    .slide-title,
    .slide-description,
    .slide-buttons {
      opacity: 1;
    }
  }

  /* Paginación vertical derecha - estilo viman.cl */
  :global(.hero-swiper .swiper-pagination) {
    right: 2rem !important;
    left: auto !important;
    top: 50% !important;
    bottom: auto !important;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: auto !important;
    z-index: 12;
  }

  :global(.hero-swiper .swiper-pagination-bullet) {
    width: 4px;
    height: 22px;
    background-color: #fff;
    opacity: 0.45;
    border-radius: 4px;
    transition: all 0.35s ease;
    margin: 0 !important;
  }

  :global(.hero-swiper .swiper-pagination-bullet:hover) {
    opacity: 0.8;
  }

  :global(.hero-swiper .swiper-pagination-bullet-active) {
    opacity: 1;
    height: 40px;
    background-color: var(--viman-secondary, #fb9500);
  }

  @media (max-width: 768px) {
    :global(.hero-swiper .swiper-pagination) {
      right: 1rem !important;
    }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Pagination, Autoplay } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';

  const swiper = new Swiper('.hero-swiper', {
    modules: [Pagination, Autoplay],
    direction: 'horizontal',
    effect: 'slide',
    loop: true,
    autoplay: {
      delay: 5000,
      disableOnInteraction: false,
      pauseOnMouseEnter: true,
    },
    speed: 800,
    pagination: {
      el: '.swiper-pagination',
      clickable: true,
    },
  });
</script>
